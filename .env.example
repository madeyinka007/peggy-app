# Peggy CMS — environment variable reference (deployment-guide §4)
# Copy to .env.development / .env.preview / .env.production and fill in.

# Database (Neon HTTP in prod/preview; local PG in dev)
DATABASE_URL=postgres://peggy:peggy@localhost:5432/peggy

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
BETTER_AUTH_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
COOKIE_DOMAIN=localhost

# Cloudinary (sign-only server side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (OQ-03)
RATE_LIMIT_PRESET=lambda

# Audit retention (OQ-04)
AUDIT_RETENTION_MONTHS=12

# Worker
WEBHOOK_WORKER_ENABLED=false

# Session lifetimes (spike-verified defaults)
SESSION_EXPIRES_DAYS=7
SESSION_UPDATE_AGE_H=24
COOKIE_CACHE_S=300

# Admin (baked at build)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Logging
LOG_LEVEL=info
